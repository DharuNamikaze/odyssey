rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Habits collection
    match /habits/{habitId} {
      // Allow read if authenticated and user owns the habit
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow create if authenticated and setting own userId
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Allow update/delete if authenticated and user owns the habit
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Pages collection
    match /pages/{pageId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can only read/write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Audit log (write-only for users, read for admins)
    match /auditLog/{logId} {
      allow read: if false; // Only admins can read (implement admin check if needed)
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs are immutable
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
